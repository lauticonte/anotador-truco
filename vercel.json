{
  "framework": "astro",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/api/ads-text.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/guia-truco",
      "destination": "/guia-truco.html"
    },
    {
      "source": "/resultado/nosotros",
      "destination": "/resultado/nosotros.html"
    },
    {
      "source": "/resultado/ellos",
      "destination": "/resultado/ellos.html"
    },
    {
      "source": "/resultado/:winner",
      "destination": "/resultado.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/resultado/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/not-found.js": {
      "includeFiles": "public/404.html"
    }
  }
}

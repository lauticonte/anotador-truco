{
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/api/ads-text.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/guia-truco",
      "destination": "/guia-truco.html"
    },
    {
      "source": "/resultado/:winner",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
